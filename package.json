{
  "name": "azure-lupa",
  "version": "0.0.1",
  "description": "Open-source, local and read-only explorer for navigating your Azure resource inventory",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaelherik/azure-lupa.git"
  },
  "homepage": "https://github.com/rafaelherik/azure-lupa#readme",
  "bugs": {
    "url": "https://github.com/rafaelherik/azure-lupa/issues"
  },
  "type": "module",
  "bin": {
    "azure-lupa": "bin/azure-lupa.js"
  },
  "files": [
    "bin",
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch src/server/cli.ts --no-open --port 4517 --token dev\" \"vite\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build && tsup",
    "start": "node bin/azure-lupa.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@azure/identity": "^4.14.0",
    "@fastify/static": "^10.1.6",
    "commander": "^15.0.0",
    "fastify": "^5.12.7",
    "open": "^11.0.4",
    "p-limit": "^7.3.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.19",
    "@threeveloper/azure-react-icons": "^1.1.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "apache-arrow": "17.0.0",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.56.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "keywords": [
    "azure",
    "inventory",
    "azure-cli",
    "resource-graph"
  ]
}
